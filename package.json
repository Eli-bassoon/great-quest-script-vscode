{
  "name": "great-quest-script",
  "displayName": "Great Quest Script",
  "publisher": "eli-bassoon",
  "description": "Language support for Great Quest Script",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "Frogger",
    "Great Quest",
    "FrogLord",
    "Modding"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Eli-bassoon/great-quest-script-vscode"
  },
  "homepage": "https://github.com/Eli-bassoon/great-quest-script-vscode/blob/main/README.md",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "images/icon.webp",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "gqs",
        "aliases": [
          "Great Quest Script",
          "gqs"
        ],
        "extensions": [
          ".gqs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gqs",
        "scopeName": "source.gqs",
        "path": "./syntaxes/gqs.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Great Quest Script",
      "type": "object",
      "properties": {
        "greatQuestScript.inlineDialog": {
          "type": "boolean",
          "default": true,
          "description": "Whether to show dialog inline when it is used by ShowDialog and OnDialogAdvance"
        },
        "greatQuestScript.goToNextLineInSectionHeaders": {
          "type": "boolean",
          "default": true,
          "description": "Whether to move the cursor to the next line when autocompleting section headers."
        },
        "greatQuestScript.addSpaceAfterAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Whether to add a space after accepting certain autocompleted suggestions."
        },
        "greatQuestScript.autogenerateHash": {
          "type": "boolean",
          "default": true,
          "description": "Whether to automatically generate a random hash when autocompleting a sequence section header."
        },
        "greatQuestScript.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Whether to enable diagnostic error messages."
        }
      }
    },
    "configurationDefaults": {
      "[gqs]": {
        "editor.wordSeparators": "`~!@#$%^&*()=+\\|;:'\",<>/?",
        "editor.stickyScroll.defaultModel": "foldingProviderModel"
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.120.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/vsce": "^3.9.1"
  }
}
